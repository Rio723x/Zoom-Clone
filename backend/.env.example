# Copy to .env and fill in. Never commit the real .env.

# From https://app.videosdk.live -> API keys. The secret stays on the server;
# browsers only ever receive short-lived tokens signed with it.
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=

# Optional overrides
# DATABASE_URL=sqlite:///./zoomclone.db
# CORS_ORIGINS=["http://localhost:3000"]
# DEFAULT_HOST_NAME=Alex Johnson
