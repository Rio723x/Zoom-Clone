# VideoSDK credentials — this is ALL you need.
#
# The build (vite.config.ts) signs the client tokens automatically from these
# two values, so deploying just means setting them as env vars on your host
# (Vercel/Netlify/etc.) — no manual token step. The secret is used only at
# build time and is never shipped to the client.
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET=

# Optional: token lifetime (default 7d). Since tokens are baked at build time,
# raise this to redeploy less often, e.g. 30d. A redeploy always refreshes them.
# VIDEOSDK_TOKEN_EXPIRY=7d

# Optional fallback: paste a dashboard token directly instead of using the
# key/secret above. Only used when VIDEOSDK_API_KEY/SECRET are not set.
# VITE_VIDEOSDK_TOKEN=
# VITE_VIDEOSDK_API_TOKEN=
